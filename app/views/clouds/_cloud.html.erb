<% # locals: (cloud:) %>
<%= link_to cloud_path(id: cloud.participant.slug),
class: "group relative overflow-hidden rounded-xl bg-white border border-gray-200 shadow-md hover:shadow-xl transition-all duration-300 hover:-translate-y-1 hover:border-red-300" do %>
  <div
    class="aspect-square relative overflow-hidden bg-gradient-to-br from-red-50 to-pink-50 cursor-pointer"
  >
    <% if cloud.generated_image.attached? %>
      <%= image_tag cloud.generated_image,
          alt: "#{cloud.participant.full_name}'s cloud card",
          class: "w-full h-full object-cover transition-transform duration-300 group-hover:scale-105",
          loading: "lazy" %>
    <% else %>
      <div class="w-full h-full flex items-center justify-center">
        <div class="text-red-400">
          <svg
            class="w-12 h-12 animate-spin"
            fill="none"
            viewBox="0 0 24 24"
          >
            <circle
              class="opacity-25"
              cx="12"
              cy="12"
              r="10"
              stroke="currentColor"
              stroke-width="4"
            />
            <path
              class="opacity-75"
              fill="currentColor"
              d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
            />
          </svg>
        </div>
      </div>
    <% end %>
  </div>

  <div class="p-4 bg-white border-t border-gray-100">
    <div class="flex items-center justify-between">
      <div class="flex-1 min-w-0">
        <h3 class="font-bold text-gray-800 text-lg truncate group-hover:text-red-600 transition-colors duration-300">
          <%= cloud.participant.full_name %>
        </h3>
        <p class="text-sm text-gray-600 mt-1 font-mono-martian">
          <%= time_ago_in_words(cloud.created_at) %> ago
        </p>
      </div>

      <button
        class="ml-3 flex-shrink-0 p-2.5 rounded-full bg-gradient-to-r from-red-50 to-pink-50 text-red-600 hover:from-red-600 hover:to-pink-600 hover:text-white transition-all duration-300 hover:scale-110 shadow-sm hover:shadow-md cursor-pointer"
        aria-label="Share"
        title="Share to social media"
        data-controller="sharer"
        data-sharer-url-value="<%= cloud_path(id: cloud.participant.slug) %>"
        data-sharer-user-name-value="<%= cloud.participant.full_name %>"
        data-action="sharer#share:prevent"
      >
        <svg
          class="w-5 h-5"
          fill="currentColor"
          viewBox="0 0 24 24"
        >
          <path d="M18 16.08c-.76 0-1.44.3-1.96.77L8.91 12.7c.05-.23.09-.46.09-.7s-.04-.47-.09-.7l7.05-4.11c.54.5 1.25.81 2.04.81 1.66 0 3-1.34 3-3s-1.34-3-3-3-3 1.34-3 3c0 .24.04.47.09.7L8.04 9.81C7.5 9.31 6.79 9 6 9c-1.66 0-3 1.34-3 3s1.34 3 3 3c.79 0 1.5-.31 2.04-.81l7.12 4.16c-.05.21-.08.43-.08.65 0 1.61 1.31 2.92 2.92 2.92 1.61 0 2.92-1.31 2.92-2.92s-1.31-2.92-2.92-2.92z" />
        </svg>
      </button>
    </div>
  </div>
<% end %>
