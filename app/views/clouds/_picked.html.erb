<% # locals: (cloud: @picked_cloud) %>
<div
  class="fixed inset-0 z-50 flex items-center justify-center bg-black/90 backdrop-blur-sm p-4 overflow-y-auto"
  data-controller="navigator"
  data-navigator-url-value="<%= root_path %>"
  data-action="click->navigator#go:self"
>
  <%= link_to root_url,
      class: "absolute top-2 right-2 flex items-center justify-center w-10 h-10 sm:w-12 sm:h-12 rounded-full bg-white/10 backdrop-blur-sm border border-white/20 text-white hover:bg-red-600 hover:border-red-600 transition-all duration-300 hover:scale-110",
      "aria-label": "Close" do %>
    <svg
      class="w-5 h-5 sm:w-6 sm:h-6"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M6 18L18 6M6 6l12 12"
      />
    </svg>
  <% end %>
  <div
    class="relative w-full max-w-4xl my-8"
  >
    <div class="bg-white rounded-2xl overflow-hidden shadow-2xl border border-gray-200">
      <div class="relative">
        <%= image_tag cloud.generated_image,
            alt: "#{cloud.participant.full_name}'s cloud card",
            class: "w-full h-auto max-h-[70vh] object-contain bg-gradient-to-br from-red-50 to-pink-50" %>
      </div>

      <div class="p-6 sm:p-8 bg-gradient-to-br from-red-50/50 to-pink-50/50 border-t border-gray-100">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
          <div>
            <h3 class="text-2xl sm:text-3xl font-bold bg-gradient-to-r from-red-600 to-pink-600 bg-clip-text text-transparent">
              <%= cloud.participant.full_name %>
            </h3>
            <p class="text-gray-600 mt-2 font-semibold font-mono-martian">
              Created <%= time_ago_in_words(cloud.created_at) %> ago
            </p>
          </div>

          <div class="flex gap-3">
            <%= link_to rails_blob_path(cloud.generated_image, disposition: :attachment),
                class: "flex items-center gap-2 px-4 py-2.5 bg-white border-2 border-red-200 text-red-600 font-semibold rounded-lg hover:bg-red-50 hover:border-red-300 transition-all duration-300 hover:scale-105" do %>
              <svg
                class="w-5 h-5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"
                />
              </svg>
              <span class="hidden sm:inline">Download</span>
            <% end %>

            <button
              class="flex items-center gap-2 px-4 py-2.5 bg-gradient-to-r from-red-600 to-pink-600 text-white font-semibold rounded-lg shadow-lg transition-all duration-300 hover:scale-105 hover:shadow-xl hover:from-red-500 hover:to-pink-500 cursor-pointer"
              data-controller="sharer"
              data-sharer-image-url-value="<%= cloud_image_url(cloud_id: cloud.participant.slug) %>"
              data-sharer-user-name-value="<%= cloud.participant.full_name %>"
              data-action="sharer#share:prevent"
            >
              <svg
                class="w-5 h-5"
                fill="currentColor"
                viewBox="0 0 24 24"
              >
                <path d="M18 16.08c-.76 0-1.44.3-1.96.77L8.91 12.7c.05-.23.09-.46.09-.7s-.04-.47-.09-.7l7.05-4.11c.54.5 1.25.81 2.04.81 1.66 0 3-1.34 3-3s-1.34-3-3-3-3 1.34-3 3c0 .24.04.47.09.7L8.04 9.81C7.5 9.31 6.79 9 6 9c-1.66 0-3 1.34-3 3s1.34 3 3 3c.79 0 1.5-.31 2.04-.81l7.12 4.16c-.05.21-.08.43-.08.65 0 1.61 1.31 2.92 2.92 2.92 1.61 0 2.92-1.31 2.92-2.92s-1.31-2.92-2.92-2.92z" />
              </svg>
              <span class="hidden sm:inline">Share</span>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
