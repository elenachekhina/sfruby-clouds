<div class="min-h-screen bg-white text-gray-800 flex flex-col">
  <header class="bg-white shadow-sm border-b border-gray-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div>
          <h1 class="text-4xl md:text-5xl font-bold bg-gradient-to-r from-red-600 to-pink-600 bg-clip-text text-transparent">
            Cloud Cards
          </h1>
          <p class="text-gray-700 mt-2 text-lg">
            Look who is in the clouds.
            <%= link_to "Join in!", "https://sfruby.com",
                target: "_blank",
                rel: "noopener noreferrer",
                class: "font-semibold text-red-600 hover:text-pink-600 transition-colors duration-300 underline decoration-2 underline-offset-2" %>
          </p>
        </div>

        <div class="flex gap-8">
          <div class="text-center">
            <div class="text-3xl md:text-4xl font-bold bg-gradient-to-r from-red-600 to-pink-600 bg-clip-text text-transparent">
              <%= @clouds.size %>
            </div>
            <div class="text-sm font-semibold text-gray-600 mt-1">
              Cloud <%= "Card".pluralize(@clouds.size) %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </header>

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 flex-1">
    <% if @clouds.empty? %>
      <div class="text-center py-20">
        <div class="inline-flex items-center justify-center w-24 h-24 bg-gradient-to-br from-red-50 to-pink-50 rounded-full mb-6">
          <svg
            class="w-12 h-12 text-red-400"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.5"
              d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"
            />
          </svg>
        </div>
        <h2 class="text-2xl font-bold text-gray-800 mb-3">
          No cloud cards yet
        </h2>
        <p class="text-gray-600 text-lg">
          The gallery will fill up as attendees generate their cloud
          cards!
        </p>
      </div>
    <% else %>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
        <%= render collection: @clouds, partial: "cloud" %>
      </div>
    <% end %>
  </main>

  <footer class="py-12 border-t border-gray-200 bg-gradient-to-br from-red-50/30 to-pink-50/30">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <p class="text-gray-700 text-lg">
        Made with <span class="text-red-600">❤️</span> for
        <%= link_to "San Francisco Ruby Conference", "https://sfruby.com",
            target: "_blank",
            rel: "noopener noreferrer",
            class: "font-bold text-red-600 hover:text-pink-600 transition-colors duration-300 hover:underline" %>
      </p>
    </div>
  </footer>
</div>

<% if @picked_cloud %>
  <%= render "picked" %>
<% end %>
