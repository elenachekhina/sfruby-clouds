<!DOCTYPE html>
<html>
<head>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
  <style>
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      background-color: #f3f4f6;
      margin: 0;
      padding: 0;
    }
    .email-container {
      max-width: 600px;
      margin: 0 auto;
      background-color: #ffffff;
    }
    .header {
      padding: 40px 20px;
      text-align: center;
    }
    .header-image {
      max-width: 300px;
      width: 100%;
      height: auto;
      margin: 0 auto 20px auto;
      display: block;
    }
    .header h1 {
      color: #325abc;
      margin: 0;
      font-size: 28px;
      font-weight: bold;
    }
    .header p {
      color: #4f97f2;
      margin: 10px 0 0 0;
      font-size: 16px;
    }
    .content {
      padding: 40px 30px;
    }
    .greeting {
      font-size: 20px;
      color: #1f2937;
      margin-bottom: 20px;
    }
    .body-text {
      font-size: 16px;
      line-height: 1.6;
      color: #4b5563;
      margin-bottom: 20px;
    }
    .body-text a {
      font-size: 16px;
      line-height: 1.6;
      color: #4f97f2;
    }
    .cta-button {
      display: inline-block;
      padding: 16px 32px;
      background: linear-gradient(135deg, #3b82f6 0%, #8b5cf6 100%);
      color: #ffffff !important;
      text-decoration: none;
      border-radius: 8px;
      font-weight: bold;
      font-size: 18px;
      margin: 20px 0;
      text-align: center;
    }
    .cta-button:hover {
      background: linear-gradient(135deg, #2563eb 0%, #7c3aed 100%);
    }
    .url-box {
      background-color: #f9fafb;
      border: 1px solid #e5e7eb;
      border-radius: 6px;
      padding: 15px;
      margin: 20px 0;
      word-break: break-all;
      font-family: monospace;
      font-size: 14px;
      color: #6b7280;
    }
    .instructions {
      background-color: #eff6ff;
      border-left: 4px solid #3b82f6;
      padding: 20px;
      margin: 30px 0;
      border-radius: 4px;
    }
    .instructions h3 {
      margin-top: 0;
      color: #1e40af;
      font-size: 18px;
    }
    .instructions ul {
      margin: 10px 0;
      padding-left: 20px;
      color: #1e40af;
    }
    .instructions li {
      margin: 8px 0;
    }
    .footer {
      background-color: #f9fafb;
      padding: 30px;
      text-align: center;
      border-top: 1px solid #e5e7eb;
    }
    .footer p {
      margin: 5px 0;
      font-size: 14px;
      color: #6b7280;
    }
    .cloud-emoji {
      font-size: 48px;
      margin: 20px 0;
    }
  </style>
</head>
<body>
  <div class="email-container">
    <!-- Header -->
    <div class="header">
      <% if attachments["sfruby_email.png"] && !attachments["sfruby_email.png"].url.starts_with?("cid:") %>
        <%= image_tag attachments["sfruby_email.png"].url, alt: "SF Ruby Character", class: "header-image" %>
      <% else %>
        <%= image_tag "/sfruby_email.png", alt: "SF Ruby Character", class: "header-image" %>
      <% end %>
      <h1>☁️ San Francisco Ruby Conference</h1>
      <% if content_for?(:title) %>
        <p><%= yield :title %></p>
      <% else %>
        <p><%= message.subject %></p>
      <% end %>
    </div>

    <div class="content">
      <%= yield %>
    </div>
    <!-- Footer -->
    <div class="footer">
      <p><strong>San Francisco Ruby Conference</strong></p>
      <p>November 19-21, 2025</p>
      <% if participant %>
        <p style="margin-top: 20px; font-size: 12px;">
          This email was sent to <%= participant.email %> because you're registered for the conference.
        </p>
      <% end %>
    </div>
  </div>
</body>
</html>
