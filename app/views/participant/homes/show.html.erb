<% content_for(:title) do %>
  Your Cloud Cards
<% end %>

<div class="min-h-screen bg-gradient-to-br from-blue-50 to-purple-50 py-8 px-4">
  <div class="max-w-4xl mx-auto flex flex-col gap-8 items-center">
    <div class="bg-white rounded-2xl shadow-xl overflow-hidden p-8">
      <div class="text-center mb-6">
        <h2 class="text-2xl font-bold bg-gradient-to-r from-blue-600 to-purple-600 bg-clip-text text-transparent">
          Your Cloud Cards
        </h2>
        <p class="text-gray-600 mt-2">
          <%= @clouds.size %> <%= "card".pluralize(@clouds.size) %> generated
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <%= render collection: @clouds, partial: "cloud" %>
      </div>

      <div class="mt-6 text-center">
        <%= link_to root_url, class: "inline-flex items-center px-6 py-3 bg-gradient-to-r from-blue-600 to-purple-600 text-white font-semibold rounded-lg hover:shadow-lg transition-shadow" do %>
          View Gallery
          <svg
            class="w-4 h-4 ml-2"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M13 7l5 5m0 0l-5 5m5-5H6"
            />
          </svg>
        <% end %>
      </div>
    </div>

    <% if @participant.cloud_generations_remained.zero? %>
      <div class="text-center py-12">
        <div class="inline-flex items-center justify-center w-16 h-16 bg-amber-100 rounded-full mb-4">
          <svg
            class="w-8 h-8 text-amber-600"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
            />
          </svg>
        </div>
        <h3 class="text-xl font-bold text-gray-900 mb-2">
          Maximum Attempts Reached
        </h3>
        <p class="text-gray-600 mb-6">
          You've used all <%= @participant.cloud_generations_quota %> generation attempts.
          <%= @clouds.any? ? " You can still select which card appears in the gallery above." : " Please contact support if you need assistance." %>
        </p>
        <% if @clouds.any? %>
          <%= link_to "/", class: "inline-flex items-center px-6 py-3 bg-gradient-to-r from-blue-600 to-purple-600 text-white font-semibold rounded-lg hover:shadow-lg transition-shadow" do %>
            View Gallery
            <svg
              class="w-4 h-4 ml-2"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M13 7l5 5m0 0l-5 5m5-5H6"
              />
            </svg>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <%= link_to new_participant_cloud_path(access_token: @participant.access_token), class: "inline-flex items-center px-6 py-3 bg-gradient-to-r from-blue-600 to-purple-600 text-white font-semibold rounded-lg hover:shadow-lg transition-shadow" do %>
        Generate New Cloud Card
      <% end %>
    <% end %>
  </div>
</div>
