<% #locals: (cloud:) %>
<div
  class="relative rounded-lg overflow-hidden border-4 transition-all cursor-pointer <%= cloud.picked? ? "border-purple-600 shadow-lg" : "border-gray-200 hover:border-purple-300" %>"
>
  <%= image_tag cloud.generated_image, alt: "Generated cloud card", class: "w-full h-auto" %>
  <% if cloud.picked? %>
    <div class="absolute top-2 right-2 bg-purple-600 text-white px-3 py-1 rounded-full text-sm font-semibold flex items-center gap-1">
      <svg
        class="w-4 h-4"
        fill="currentColor"
        viewBox="0 0 20 20"
      >
        <path
          fill-rule="evenodd"
          d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
          clip-rule="evenodd"
        />
      </svg>
      In Gallery
    </div>
  <% end %>
</div>
