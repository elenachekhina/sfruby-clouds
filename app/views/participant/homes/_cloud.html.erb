<% #locals: (cloud:) %>
<div
  class="relative rounded-lg overflow-hidden border-4 transition-all <%= cloud.picked? ? "border-purple-600 shadow-lg" : "border-gray-200 #{cloud.generated? ? "hover:border-purple-300" : ""}" %>"
>
  <% if cloud.generated? %>
    <% if cloud.picked? %>
      <%= image_tag cloud.generated_image, alt: "Generated cloud card", class: "w-full h-auto" %>
      <div class="absolute top-2 right-2 bg-purple-600 text-white px-3 py-1 rounded-full text-sm font-semibold flex items-center gap-1">
        <svg
          class="w-4 h-4"
          fill="currentColor"
          viewBox="0 0 20 20"
        >
          <path
            fill-rule="evenodd"
            d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
            clip-rule="evenodd"
          />
        </svg>
        In Gallery
      </div>
    <% else %>
      <%= button_to participant_cloud_path(access_token: @participant.access_token, id: cloud.id), method: :patch, class: "cursor-pointer border-none outline-none w-full h-auto" do %>
        <%= image_tag cloud.generated_image, alt: "Generated cloud card", class: "w-full h-auto" %>
      <% end %>
    <% end %>
  <% elsif cloud.failed? %>
    <div class="w-full h-full bg-red-50 border-2 border-red-200 flex flex-col items-center justify-center text-center p-4">
      <div class="bg-red-100 rounded-full p-3 mb-3">
        <svg
          class="w-8 h-8 text-red-600"
          fill="currentColor"
          viewBox="0 0 20 20"
        >
          <path
            fill-rule="evenodd"
            d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z"
            clip-rule="evenodd"
          />
        </svg>
      </div>
      <h3 class="text-red-800 font-semibold mb-2">Generation Failed</h3>
      <p class="text-red-600 text-sm">
        <%= cloud.failure_reason.presence || "An error occurred during image generation" %>
      </p>
    </div>
  <% else %>
    <div class="w-full h-full bg-blue-50 border-2 border-blue-200 flex flex-col items-center justify-center text-center p-4">
        <div class="bg-blue-100 rounded-full p-3 mb-3">
          <svg
            class="w-8 h-8 text-blue-600 animate-spin"
            fill="none"
            viewBox="0 0 24 24"
          >
            <circle
              class="opacity-25"
              cx="12"
              cy="12"
              r="10"
              stroke="currentColor"
              stroke-width="4"
            />
            <path
              class="opacity-75"
              fill="currentColor"
              d="m4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
            />
          </svg>
        </div>
        <h3 class="text-blue-800 font-semibold mb-2">Generating Image</h3>
        <p class="text-blue-600 text-sm">
          Please wait while your cloud image is being created...
        </p>
      </div>
  <% end %>
</div>
