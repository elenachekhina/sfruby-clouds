<% content_for(:title) do %>
  Your Cloud Card is on its way
<% end %>

<div class="min-h-screen bg-gradient-to-br from-blue-50 to-purple-50 py-8 px-4">
  <%= turbo_stream_from @cloud %>
  <div class="max-w-4xl mx-auto flex flex-col gap-8 items-center">
    <div class="max-w-2xl w-full bg-white rounded-2xl shadow-xl overflow-hidden">
      <div class="p-6 text-white">
        <div class="text-center">
          <% unless @cloud.generated? || @cloud.failed? %>
            <div class="inline-flex items-center justify-center w-20 h-20 bg-blue-100 rounded-full mb-4">
              <svg
                class="w-10 h-10 text-blue-600 animate-spin"
                fill="none"
                viewBox="0 0 24 24"
              >
                <circle
                  class="opacity-25"
                  cx="12"
                  cy="12"
                  r="10"
                  stroke="currentColor"
                  stroke-width="4"
                />
                <path
                  class="opacity-75"
                  fill="currentColor"
                  d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
                />
              </svg>
            </div>
          <% end %>

          <h2 class="text-2xl font-bold text-gray-900 mb-2">
            Creating Your Cloud Card
          </h2>

          <% unless @cloud.generated? || @cloud.failed? %>
            <p class="text-gray-600 mb-6">
              This magical transformation takes about 30 seconds...
            </p>
          <% end %>

          <% if @cloud.generated? %>
            <p class="text-gray-600 mb-6">
              Here you go! Click on the card to add it to our gallery or go to <%= link_to "all your clouds", participant_home_path(access_token: @participant.access_token), class: "text-blue-600 hover:text-blue-700 font-semibold" %>
            </p>
          <% end %>

          <% if @cloud.failed? %>
            <p class="text-gray-600 mb-6">
              Hm, something went wrong. Go to <%= link_to "all your clouds", participant_home_path(access_token: @participant.access_token), class: "text-blue-600 hover:text-blue-700 font-semibold" %> to try again!
            </p>
          <% end %>

          <div class="space-y-2">
            <% if @cloud.uploaded? %>
              <div class="flex items-center justify-center text-sm text-gray-500">
                <span class="animate-pulse">Preparing to take off</span>
              </div>
            <% elsif @cloud.analyzing? %>
              <div class="flex items-center justify-center text-sm text-gray-500">
                <span class="animate-pulse">Analyzing your photo</span>
              </div>
            <% elsif @cloud.analyzed? %>
              <div class="flex items-center justify-center text-sm text-gray-500">
                <span class="animate-pulse">Looks good! Hang on</span>
              </div>
            <% elsif @cloud.generating? %>
              <div class="flex items-center justify-center text-sm text-gray-500">
                <span class="animate-pulse">
                  Transforming into a cloud character
                </span>
              </div>
              <div class="flex items-center justify-center text-sm text-gray-500 hidden" data-controller="delayed_show">
                <span class="animate-pulse">Adding SF Ruby magic</span>
              </div>
            <% else %>
              <%= render partial: "participant/homes/cloud", locals: {cloud: @cloud} %>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
