<% # locals: (participant: @participant, regeneration: @clouds&.any?) %>
<div class="max-w-2xl w-full bg-white rounded-2xl shadow-xl overflow-hidden">
  <div class="bg-gradient-to-r from-blue-600 to-purple-600 p-6 text-white">
    <h1 class="text-3xl font-bold">
      <%= regeneration ? "Try Again" : "Welcome" %>, <%= participant.full_name %>!
    </h1>
    <p class="mt-2 opacity-90">
      <%= regeneration ? "Upload a new photo to regenerate your Cloud Card" : "Let's create your Cloud Card for the San Francisco Ruby Conference" %>
    </p>
    <% if participant.cloud_generations_remained.nonzero? %>
      <div class="mt-3 flex items-center gap-2">
        <div class="flex items-center gap-1">
          <% participant.cloud_generations_quota.times do |i| %>
            <div
              class="w-2 h-2 rounded-full <%= i < participant.cloud_generations_count ? 'bg-white/40' : 'bg-white' %>"
              title="<%= i < (participant.cloud_generations_count || 0) ? 'Used' : 'Available' %>"
            ></div>
          <% end %>
        </div>
        <span class="text-sm font-semibold">
          <%= participant.cloud_generations_remained %>
          <%= "attempt".pluralize(count: participant.cloud_generations_remained) %>
          remaining
        </span>
      </div>
    <% end %>
  </div>

  <div class="p-8">
    <!-- Error messages -->
    <% if @initial_error.present? || @errors&.dig(:photo).present? %>
      <div class="mb-6 p-4 bg-red-50 border border-red-200 rounded-lg">
        <p class="text-red-700"><%= @initial_error || @errors[:photo] %></p>
      </div>
    <% end %>

    <!-- Show attempts exhausted message -->
    <%= form_with url: request.path, multipart: true, id: "upload-form" do |form| %>
      <!-- Upload area -->
      <div
        id="upload-area"
        class="relative border-2 border-dashed rounded-xl p-8 text-center transition-colors border-gray-300 hover:border-gray-400"
      >
        <%= form.file_field :photo,
              accept: "image/jpeg,image/jpg,image/png,image/webp",
              class: "hidden",
              id: "file-input" %>

        <div id="preview-area" class="space-y-4" style="display: none;">
          <div class="relative inline-block">
            <img
              id="preview-image"
              alt="Preview"
              class="max-w-full max-h-64 rounded-lg shadow-lg mx-auto"
            />
            <button
              type="button"
              id="remove-preview"
              class="absolute -top-2 -right-2 bg-red-500 text-white rounded-full p-1 hover:bg-red-600 transition-colors"
            >
              <svg
                class="w-5 h-5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M6 18L18 6M6 6l12 12"
                />
              </svg>
            </button>
          </div>
          <p class="text-sm text-gray-600">
            Click submit to generate your cloud card
          </p>
        </div>

        <div id="upload-placeholder">
          <svg
            class="mx-auto h-12 w-12 text-gray-400 mb-4"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.5"
              d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"
            />
          </svg>
          <p class="text-gray-600 mb-2">
            Drag and drop your photo here, or
            <button
              type="button"
              id="browse-button"
              class="text-blue-600 hover:text-blue-700 font-semibold"
            >
              browse
            </button>
          </p>
          <p class="text-sm text-gray-500">
            Maximum file size: 10MB • Formats: JPEG, PNG, WebP
          </p>
        </div>
      </div>

      <!-- Submit button -->
      <div class="mt-6 flex justify-center">
        <button
          type="submit"
          id="submit-button"
          disabled
          class="px-8 py-3 rounded-lg font-semibold transition-all bg-gray-200 text-gray-400 cursor-not-allowed"
        >
          <%= regeneration ? "Regenerate My Cloud Card" : "Generate My Cloud Card" %>
        </button>
      </div>

      <!-- Instructions -->
      <div class="mt-8 p-4 bg-blue-50 rounded-lg">
        <h3 class="font-semibold text-gray-900 mb-2">
          Tips for best results:
        </h3>
        <ul class="text-sm text-gray-600 space-y-1">
          <li>• Use a clear photo with your face visible</li>
          <li>
            • Good lighting helps create better cloud characters
          </li>
          <li>
            • Keep it professional - this will be shared with other
            people
          </li>
        </ul>
      </div>
    <% end %>
  </div>
</div>
