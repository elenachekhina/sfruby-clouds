<!--claude-->
<%= field_wrapper **field_wrapper_args do %>
  <div class="flex items-center gap-3">
    <% if @field.display_value %>
      <div class="text-right text-sm font-semibold leading-none min-w-[3rem]">
        <%= @field.value %>/<%= @field.max %><%= @field.value_suffix if @field.value_suffix.present? %>
      </div>
    <% end %>
    <progress max="<%= @field.max %>" value="<%= @field.value %>" class="block min-w-[12rem] max-w-xs rounded-full h-2 overflow-hidden bg-gray-200"></progress>
  </div>
<% end %>